<?xml version="1.0"?>
<robot name="arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="camera_enabled" default="true"/>
  <xacro:arg name="camera_mount_mode" default="ee"/>
  <xacro:arg name="camera_name" default="camera"/>
  <xacro:arg name="camera_parent_link" default="auto"/>
  <xacro:arg name="camera_xyz" default="auto"/>
  <xacro:arg name="camera_rpy" default="auto"/>
  <xacro:arg name="camera_use_nominal_extrinsics" default="true"/>
  <xacro:arg name="rgbd_enabled" default="true"/>
  <xacro:arg name="rgbd_namespace" default="d435i"/>
  <xacro:arg name="rgbd_camera_name" default="color"/>
  <xacro:arg name="rgbd_frame_name" default="camera_depth_optical_frame"/>
  <xacro:arg name="rgbd_update_rate" default="15"/>
  <xacro:arg name="rgbd_width" default="640"/>
  <xacro:arg name="rgbd_height" default="480"/>
  <xacro:arg name="rgbd_horizontal_fov" default="1.211"/>
  <xacro:arg name="rgbd_near" default="0.1"/>
  <xacro:arg name="rgbd_far" default="5.0"/>
  <xacro:arg name="rgbd_visualize" default="false"/>
  <xacro:arg name="imu_enabled" default="true"/>
  <xacro:arg name="imu_namespace" default="d435i"/>
  <xacro:arg name="imu_topic" default="imu"/>
  <xacro:arg name="imu_frame_name" default="camera_accel_optical_frame"/>
  <xacro:arg name="imu_update_rate" default="200"/>
  <xacro:arg name="imu_visualize" default="false"/>
  <xacro:arg name="imu_noise_mean" default="0.0"/>
  <xacro:arg name="imu_angular_velocity_noise_stddev" default="0.0"/>
  <xacro:arg name="imu_linear_acceleration_noise_stddev" default="0.0"/>
  <xacro:arg name="use_ros2_control" default="true"/>
  <xacro:arg name="fix_base_to_world" default="true"/>

  <xacro:include filename="$(find manipulator)/arm.urdf"/>
  <xacro:include filename="$(find manipulator)/sensors/d435i_mount.xacro"/>
  <xacro:include filename="$(find manipulator)/sensors/d435i_gazebo.xacro"/>
  <xacro:include filename="$(find manipulator)/sensors/gazebo_ros2_control.xacro"/>

  <xacro:property name="camera_mount_mode_arg" value="$(arg camera_mount_mode)"/>
  <xacro:property name="camera_parent_link_arg" value="$(arg camera_parent_link)"/>
  <xacro:property name="camera_xyz_arg" value="$(arg camera_xyz)"/>
  <xacro:property name="camera_rpy_arg" value="$(arg camera_rpy)"/>
  <xacro:property name="resolved_camera_parent_link"
                  value="${'link1' if camera_parent_link_arg == 'auto' and camera_mount_mode_arg == 'base' else 'link6' if camera_parent_link_arg == 'auto' else camera_parent_link_arg}"/>
  <xacro:property name="resolved_camera_xyz"
                  value="${'0.02 0 0.06' if camera_xyz_arg == 'auto' and camera_mount_mode_arg == 'base' else '0.06 0 0.04' if camera_xyz_arg == 'auto' else camera_xyz_arg}"/>
  <xacro:property name="resolved_camera_rpy"
                  value="${'0 0 0' if camera_rpy_arg == 'auto' else camera_rpy_arg}"/>

  <xacro:windylab_d435i_mount
      camera_enabled="$(arg camera_enabled)"
      camera_name="$(arg camera_name)"
      camera_parent_link="${resolved_camera_parent_link}"
      camera_xyz="${resolved_camera_xyz}"
      camera_rpy="${resolved_camera_rpy}"
      camera_use_nominal_extrinsics="$(arg camera_use_nominal_extrinsics)"/>

  <xacro:windylab_d435i_gazebo_rgbd
      rgbd_enabled="$(arg rgbd_enabled)"
      camera_name="$(arg camera_name)"
      rgbd_namespace="$(arg rgbd_namespace)"
      rgbd_camera_name="$(arg rgbd_camera_name)"
      rgbd_frame_name="$(arg rgbd_frame_name)"
      rgbd_update_rate="$(arg rgbd_update_rate)"
      rgbd_width="$(arg rgbd_width)"
      rgbd_height="$(arg rgbd_height)"
      rgbd_horizontal_fov="$(arg rgbd_horizontal_fov)"
      rgbd_near="$(arg rgbd_near)"
      rgbd_far="$(arg rgbd_far)"
      rgbd_visualize="$(arg rgbd_visualize)"/>

  <xacro:windylab_d435i_gazebo_imu
      imu_enabled="$(arg imu_enabled)"
      camera_name="$(arg camera_name)"
      imu_namespace="$(arg imu_namespace)"
      imu_topic="$(arg imu_topic)"
      imu_frame_name="$(arg imu_frame_name)"
      imu_update_rate="$(arg imu_update_rate)"
      imu_visualize="$(arg imu_visualize)"
      imu_noise_mean="$(arg imu_noise_mean)"
      imu_angular_velocity_noise_stddev="$(arg imu_angular_velocity_noise_stddev)"
      imu_linear_acceleration_noise_stddev="$(arg imu_linear_acceleration_noise_stddev)"/>

  <xacro:windylab_gazebo_ros2_control
      use_ros2_control="$(arg use_ros2_control)"
      fix_base_to_world="$(arg fix_base_to_world)"/>
</robot>
