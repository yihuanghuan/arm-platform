<?xml version="1.0"?>
<sdf version="1.6">
  <world name="d435i_apriltag_board_2x2">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <update_rate>10.0</update_rate>
    </plugin>

    <include>
      <uri>model://sun</uri>
    </include>

    <physics name="ode_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <model name="apriltag_ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4 4</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4 4</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.56 0.56 0.56 1</ambient>
            <diffuse>0.56 0.56 0.56 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="apriltag_back_wall">
      <pose>1.63 0.0 0.55 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.04 1.20 1.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.82 0.82 0.78 1</ambient>
            <diffuse>0.82 0.82 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <name>apriltag_36h11_board_2x2_target</name>
      <uri>model://apriltag_36h11_board_2x2</uri>
      <pose>1.60 0.0 0.35 0 -1.57079632679 0</pose>
    </include>

    <model name="depth_reference_green_box">
      <pose>0.86 -0.34 0.12 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.16 0.16 0.24</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.65 0.18 1</ambient>
            <diffuse>0.05 0.65 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
